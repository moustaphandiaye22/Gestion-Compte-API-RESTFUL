{
    "openapi": "3.0.0",
    "info": {
        "title": "API Gestion Comptes Bancaires",
        "version": "1.0.0",
        "description": "API REST pour la gestion des comptes bancaires. Permet de lister, cr\u00e9er, modifier et supprimer des comptes."
    },
    "servers": [
        {
            "url": "http://localhost/api/v1"
        }
    ],
    "paths": {
        "/_debugbar/assets/stylesheets": {
            "get": {
                "operationId": "debugbar.assets.css",
                "summary": "Return the stylesheets for the Debugbar",
                "tags": [
                    "Asset"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "text/css": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_debugbar/assets/javascript": {
            "get": {
                "operationId": "debugbar.assets.js",
                "summary": "Return the javascript for the Debugbar",
                "tags": [
                    "Asset"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "text/javascript": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_debugbar/cache/{key}/{tags}": {
            "delete": {
                "operationId": "debugbar.cache.delete",
                "summary": "Forget a cache key",
                "tags": [
                    "Cache"
                ],
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "tags",
                        "in": "path",
                        "required": true,
                        "description": "**Optional**",
                        "schema": {
                            "type": "string",
                            "default": ""
                        },
                        "x-optional": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/comptes": {
            "get": {
                "operationId": "comptes.index",
                "description": "Liste tous les comptes avec filtrage, tri et pagination.\nAdmin peut voir tous les comptes, Client ne voit que ses comptes.\nSeuls les comptes non supprim\u00e9s, de type cheque ou epargne, et actifs sont retourn\u00e9s.",
                "summary": "Lister tous les comptes",
                "tags": [
                    "Compte"
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                        }
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "Epargne",
                                "Cheque"
                            ]
                        }
                    },
                    {
                        "name": "statut",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "Actif",
                                "Bloque",
                                "Ferme"
                            ]
                        }
                    },
                    {
                        "name": "devise",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 10
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "dateCreation",
                                "solde",
                                "titulaire",
                                "numeroCompte",
                                "type",
                                "statut",
                                "devise"
                            ]
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "date_from",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "date_to",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "solde_min",
                        "in": "query",
                        "schema": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": 0
                        }
                    },
                    {
                        "name": "solde_max",
                        "in": "query",
                        "schema": {
                            "type": [
                                "number",
                                "null"
                            ],
                            "minimum": 0
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer",
                                    "enum": [
                                        200
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "post": {
                "operationId": "comptes.store",
                "summary": "Cr\u00e9er un nouveau compte",
                "tags": [
                    "Compte"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreCompteRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/comptes/{id}": {
            "get": {
                "operationId": "comptes.show",
                "description": "R\u00e9cup\u00e8re un compte sp\u00e9cifique par ID. Pour le moment, sans authentification, traiter comme admin.\nRecherche d'abord en local pour les comptes actifs (cheque/epargne), puis en serverless si non trouv\u00e9.",
                "summary": "Afficher un compte sp\u00e9cifique",
                "tags": [
                    "Compte"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "L'ID du compte",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer",
                                    "enum": [
                                        200
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "operationId": "comptes.update",
                "summary": "Mettre \u00e0 jour un compte",
                "tags": [
                    "Compte"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateCompteRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": ""
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            },
            "delete": {
                "operationId": "comptes.destroy",
                "summary": "Supprimer un compte (soft delete)",
                "tags": [
                    "Compte"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                }
            }
        },
        "/comptes-archives": {
            "get": {
                "operationId": "comptes.archives",
                "description": "Liste tous les comptes archiv\u00e9s (statut 'Supprime') avec pagination.\nAccessible uniquement aux administrateurs.",
                "summary": "R\u00e9cup\u00e9rer les comptes archiv\u00e9s",
                "tags": [
                    "Compte"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer",
                                    "enum": [
                                        200
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/sanctum/csrf-cookie": {
            "get": {
                "operationId": "sanctum.csrf-cookie",
                "summary": "Return an empty response simply to trigger the storage of the CSRF cookie in the browser",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "No content\n\nNo content",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_ignition/execute-solution": {
            "post": {
                "operationId": "ignition.executeSolution",
                "tags": [
                    "ExecuteSolution"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ExecuteSolutionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    }
                }
            }
        },
        "/_ignition/health-check": {
            "get": {
                "operationId": "ignition.healthCheck",
                "tags": [
                    "HealthCheck"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "can_execute_commands": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "can_execute_commands"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_debugbar/open": {
            "get": {
                "operationId": "debugbar.openhandler",
                "tags": [
                    "OpenHandler"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "prefixItems": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "datetime": {
                                                    "type": "string"
                                                },
                                                "id": {
                                                    "type": "null"
                                                },
                                                "ip": {
                                                    "type": "string"
                                                },
                                                "method": {
                                                    "type": "string",
                                                    "enum": [
                                                        "ERROR"
                                                    ]
                                                },
                                                "uri": {
                                                    "type": "string",
                                                    "enum": [
                                                        "!! To enable public access to previous requests, set debugbar.storage.open to true in your config, or enable DEBUGBAR_OPEN_STORAGE if you did not publish the config. !!"
                                                    ]
                                                },
                                                "utime": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "datetime",
                                                "id",
                                                "ip",
                                                "method",
                                                "uri",
                                                "utime"
                                            ]
                                        }
                                    ],
                                    "minItems": 1,
                                    "maxItems": 1,
                                    "additionalItems": false
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_debugbar/clockwork/{id}": {
            "get": {
                "operationId": "debugbar.clockwork",
                "summary": "Return Clockwork output",
                "tags": [
                    "OpenHandler"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_debugbar/queries/explain": {
            "post": {
                "operationId": "debugbar.queries.explain",
                "summary": "Generate explain data for query",
                "tags": [
                    "Queries"
                ],
                "responses": {
                    "400": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "success": {
                                                    "type": "boolean"
                                                },
                                                "message": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "message"
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "success": {
                                                    "type": "boolean"
                                                },
                                                "message": {
                                                    "type": "string",
                                                    "enum": [
                                                        "EXPLAIN is currently disabled in the Debugbar."
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "message"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "anyOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "success": {
                                                    "type": "boolean"
                                                },
                                                "data": {
                                                    "type": "string"
                                                },
                                                "visual": {
                                                    "type": [
                                                        "object",
                                                        "null"
                                                    ],
                                                    "properties": {
                                                        "confirm": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "confirm"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "data",
                                                "visual"
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "success": {
                                                    "type": "boolean"
                                                },
                                                "data": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "success",
                                                "data"
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/documentation": {
            "get": {
                "operationId": "swagger-lume.api",
                "summary": "Display Swagger API page",
                "tags": [
                    "SwaggerLume"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/oauth2-callback": {
            "get": {
                "operationId": "swagger-lume.oauth2_callback",
                "summary": "Display Oauth2 callback pages",
                "tags": [
                    "SwaggerLume"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/swagger-ui-assets/{asset}": {
            "get": {
                "operationId": "swagger-lume.asset",
                "tags": [
                    "SwaggerLumeAsset"
                ],
                "parameters": [
                    {
                        "name": "asset",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/_ignition/update-config": {
            "post": {
                "operationId": "ignition.updateConfig",
                "tags": [
                    "UpdateConfig"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateConfigRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ExecuteSolutionRequest": {
                "type": "object",
                "properties": {
                    "solution": {
                        "type": "string"
                    },
                    "parameters": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "solution"
                ],
                "title": "ExecuteSolutionRequest"
            },
            "StoreCompteRequest": {
                "type": "object",
                "properties": {
                    "numeroCompte": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "titulaire": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "Epargne",
                            "Cheque"
                        ]
                    },
                    "devise": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 10
                    },
                    "dateCreation": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "statut": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "Actif",
                            "Bloque",
                            "Ferme"
                        ]
                    },
                    "metadata": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "client_id": {
                        "type": "string",
                        "format": "uuid"
                    }
                },
                "required": [
                    "titulaire",
                    "type",
                    "client_id"
                ],
                "title": "StoreCompteRequest"
            },
            "UpdateCompteRequest": {
                "type": "object",
                "properties": {
                    "numeroCompte": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "titulaire": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "Epargne",
                            "Cheque"
                        ]
                    },
                    "devise": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 10
                    },
                    "dateCreation": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "statut": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "Actif",
                            "Bloque",
                            "Ferme"
                        ]
                    },
                    "metadata": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "client_id": {
                        "type": "string",
                        "format": "uuid"
                    }
                },
                "title": "UpdateCompteRequest"
            },
            "UpdateConfigRequest": {
                "type": "object",
                "properties": {
                    "theme": {
                        "type": "string",
                        "enum": [
                            "light",
                            "dark",
                            "auto"
                        ]
                    },
                    "editor": {
                        "type": "string"
                    },
                    "hide_solutions": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "theme",
                    "editor",
                    "hide_solutions"
                ],
                "title": "UpdateConfigRequest"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            }
        }
    }
}